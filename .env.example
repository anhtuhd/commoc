# Go API, never commit actual secrets
DATABASE_URL=postgres://commoc:CHANGE_ME@db:5432/commoc?sslmode=disable
SITE_URL=https://pishare.cloud
ADMIN_USER=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SEPAY_WEBHOOK_SECRET=
SEPAY_MODE=live
SEPAY_AUTO_MATCH=true
ZALO_BRIDGE_URL=http://zalo:8081
ZALO_BRIDGE_SECRET=
MEDIA_DIR=/data/media
# Next.js presentation service only
GO_API_URL=http://api:8080
COMMO_RUNTIME=vps
NEXT_PUBLIC_RUNTIME=vps
NEXT_PUBLIC_SITE_URL=https://pishare.cloud
COMMO_SITE_ORIGIN=https://pishare.cloud
# Product options are disabled until both API and frontend are ready.
PRODUCT_OPTIONS_ENABLED=0
# Build-time Next.js setting; must match PRODUCT_OPTIONS_ENABLED.
NEXT_PUBLIC_PRODUCT_OPTIONS_ENABLED=0
